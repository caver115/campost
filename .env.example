# Copy to .env and fill in the real values.
BOTPOST_BOT_TOKEN=123456789:replace-me
BOTPOST_CHANNEL_ID=-1000000000000
BOTPOST_URLS_FILE=urls.txt

# Cron schedule for supercronic (default: top of every hour).
BOTPOST_INTERVAL_CRON="0 * * * *"

BOTPOST_JPEG_QUALITY=95
BOTPOST_HTTP_TIMEOUT=20
BOTPOST_NOTIFY_FAILURES=true
TZ=Asia/Krasnoyarsk
